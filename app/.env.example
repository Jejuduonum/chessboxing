# App (public — safe to ship in the browser bundle)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server only (Vercel → Project → Settings → Environment Variables). Never prefix these with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash

# Optional: pulls your latest Lichess games in order (no scopes needed, read-only).
# Without it the app still lists the notable games Lichess shares publicly.
LICHESS_TOKEN=lip_...
